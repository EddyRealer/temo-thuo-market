# Firebase Configuration - DO NOT COMMIT THIS FILE
# Copy this to .env and fill in your actual values

# Firebase API Key (from Firebase Console → Project Settings → General → Your apps → SDK setup and configuration)
FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain (format: your-project.firebaseapp.com)
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID (from Firebase Console → Project Settings → General)
FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket (format: your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Firebase Messaging Sender ID (from Firebase Console → Project Settings → Cloud Messaging)
FIREBASE_MESSAGING_SENDER_ID=123456789

# Firebase App ID (from Firebase Console → Project Settings → General → Your apps)
FIREBASE_APP_ID=1:123456789:android:your_app_id

# Environment (development or production)
NODE_ENV=development

# Optional: Enable debug logging
# DEBUG=true
